# Run in codespace
import numpy as np
import matplotlib.pyplot as plt
import rebound

# Define the grid
a_max = 1.1 # maximum semimajor axis to consider (AU)
a_range = np.linspace(0.1, 1.1, 25) # Start at 0.1 to avoid division by zero in the integrator
e_range = np.linspace(0, 0.9999, 25) # End before 1 -- integrator cannot handle non-elliptical orbits
A, E = np.meshgrid(a_range, e_range)
MEGNO = np.zeros_like(A)

def calculate_megno(semimajor_axis, eccentricity):
    sim = rebound.Simulation()
    sim.integrator = "whfast"
    
    # Add Star: Gliese 65 A (Primary Mass ~0.12 Solar Masses)
    sim.add(m=0.12) 
    
    # Add the test particle (exoplanet)
    sim.add(a=semimajor_axis, e=eccentricity)
    
    # Move to Center of Momentum frame and add variational particles for MEGNO
    sim.move_to_com()
    sim.init_megno()
    
    # Integrate
    num_orbits = 500
    orbital_period  = 2 * np.pi * np.sqrt(semimajor_axis**3 / 0.12)
    sim.dt = 0.05 * orbital_period
    try:
        sim.integrate(num_orbits * orbital_period)
        return sim.calculate_megno()
    except:
        return 10.0 # Return high value for ejected/unstable orbits

# Populate the grid
for i in range(len(e_range)):
    for j in range(len(a_range)):
        MEGNO[i, j] = calculate_megno(A[i,j], E[i,j])

# Plotting
plt.figure(figsize=(20, 12))
plt.imshow(MEGNO, extent=[0.1, a_max, 0, 1], origin='lower', 
           cmap='viridis', aspect='auto', vmin=1.9, vmax=4.0)
plt.colorbar(label='MEGNO (Y)')
plt.xlabel('Semimajor Axis (AU)')
plt.ylabel('Eccentricity (e)')
plt.title("Exoplanet Stability Plot, Gliese 65 (Stability at Y = 2)")

plt.savefig('stability_plot.png')
print("Plot saved as stability_plot.png")
