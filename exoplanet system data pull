# Standard gravitational parameter for TRAPPIST-1 (Mass ≈ 0.0898 Solar Masses)
# Converting to KM and Seconds for your ODE
G_constant = 6.67430e-20 # km^3 kg^-1 s^-2
M_star = 0.0898 * 1.989e30 # kg
mu_trappist = G_constant * M_star 

def ode_func(t, state, mu=mu_trappist):
    """
    State vector: [x, y, z, vx, vy, vz]
    """
    r_vec = state[:3]
    r_mag = np.linalg.norm(r_vec)
    
    # Acceleration: a = -mu * r / r^3
    a_vec = -mu * r_vec / r_mag**3
    
    # Return derivatives: [vx, vy, vz, ax, ay, az]
    return np.array([
        state[3], state[4], state[5],
        a_vec[0], a_vec[1], a_vec[2]
    ])

